{
  "layer": "top",
  "position": "top",
  "height": 0,
  "width": 0,
  "margin": 0,
  "spacing": 0,
  "mode": "dock",
  "reload_style_on_change": true,

  /*-- Mechabar-style layout: segmented left | center | right
       Based on sejjy/mechabar (Catppuccin Mocha variant)
       Adapted for HyprConfig modules --*/

  "modules-left": [
    "custom/logo",
    "custom/left_div#1",
    "hyprland/workspaces",
    "custom/right_div#1",
    "wlr/taskbar",
    "hyprland/window"
  ],
  "modules-center": [
    "custom/left_div#2",
    "temperature",
    "custom/left_div#3",
    "memory",
    "custom/left_div#4",
    "cpu",
    "custom/left_inv#1",
    "custom/left_div#5",
    "custom/distro",
    "custom/right_div#2",
    "custom/right_inv#1",
    "idle_inhibitor",
    "clock#time",
    "custom/right_div#3",
    "clock#date",
    "custom/right_div#4",
    "network",
    "custom/right_div#5"
  ],
  "modules-right": [
    "mpris",
    "custom/left_div#6",
    "pulseaudio",
    "custom/left_inv#2",
    "tray",
    "custom/power"
  ],

  /*-- Mechabar dividers (halfblock arrows) --*/
  "custom/left_div#1": { "format": "", "tooltip": false },
  "custom/left_div#2": { "format": "", "tooltip": false },
  "custom/left_div#3": { "format": "", "tooltip": false },
  "custom/left_div#4": { "format": "", "tooltip": false },
  "custom/left_div#5": { "format": "", "tooltip": false },
  "custom/left_div#6": { "format": "", "tooltip": false },
  "custom/left_inv#1": { "format": "", "tooltip": false },
  "custom/left_inv#2": { "format": "", "tooltip": false },
  "custom/right_div#1": { "format": "", "tooltip": false },
  "custom/right_div#2": { "format": "", "tooltip": false },
  "custom/right_div#3": { "format": "", "tooltip": false },
  "custom/right_div#4": { "format": "", "tooltip": false },
  "custom/right_div#5": { "format": "", "tooltip": false },
  "custom/right_inv#1": { "format": "", "tooltip": false },

  /*-- Custom modules --*/
  "custom/logo": {
    "format": "󰍜",
    "tooltip": false,
    "on-click": "sh -c 'command -v rofi >/dev/null && (pkill -x rofi || exec rofi -show drun -show-icons)'"
  },
  "custom/distro": {
    "format": "󱄅",
    "tooltip": false
  },
  "custom/power": {
    "format": "󰤄",
    "tooltip-format": "Power Menu",
    "on-click": "sh -c 'command -v wlogout >/dev/null && exec wlogout'"
  },

  /*-- Workspaces --*/
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "all-outputs": false,
    // --- monitor-workspace map (regenerated by update-waybar-monitors.sh) ---
    "persistent-workspaces": {
      "*": [1, 2, 3]
    },
    // --- end monitor-workspace map ---
    "on-click": "activate",
    "sort-by-number": true
  },

  /*-- Taskbar --*/
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "spacing": 3,
    "on-click": "activate",
    "on-click-right": "close",
    "tooltip-format": "{title}"
  },

  /*-- Window title --*/
  "hyprland/window": {
    "max-length": 35,
    "separate-outputs": true
  },

  /*-- Clock --*/
  "clock#time": {
    "format": "{:%H:%M}",
    "min-length": 5,
    "max-length": 5,
    "tooltip-format": "<b>Standard Time</b>: <span text_transform='lowercase'>{:%I:%M %p}</span>"
  },
  "clock#date": {
    "format": "󰸗 {:%d-%m}",
    "min-length": 8,
    "max-length": 8,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 6,
      "format": {
        "months": "<span alpha='100%'><b>{}</b></span>",
        "days": "<span alpha='90%'>{}</span>",
        "weekdays": "<span alpha='80%'><i>{}</i></span>",
        "today": "<span alpha='100%'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-click": "mode" }
  },

  /*-- System --*/
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 10,
    "min-length": 7,
    "max-length": 7,
    "on-click": "sh -c 'command -v foot >/dev/null && command -v btop >/dev/null && exec foot -e btop'",
    "states": { "warning": 75, "critical": 90 },
    "tooltip": false
  },
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 10,
    "min-length": 7,
    "max-length": 7,
    "tooltip-format": "Memory Used: {used:0.0f}/{total:0.0f} GiB",
    "on-click": "sh -c 'command -v foot >/dev/null && command -v btop >/dev/null && exec foot -e btop'",
    "states": { "warning": 75, "critical": 90 }
  },
  "temperature": {
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["󱃃", "󰔏", "󱃂"],
    "critical-threshold": 90,
    "format-critical": "󰀦 {temperatureC}°C",
    "min-length": 8,
    "max-length": 8,
    "tooltip-format": "Temperature in Fahrenheit: {temperatureF}°F"
  },

  /*-- Audio / Network --*/
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "headphone-muted": "󰟎",
      "default": ["󰕿", "󰖀", "󰕾"],
      "default-muted": "󰝟"
    },
    "min-length": 7,
    "max-length": 7,
    "on-click": "sh -c 'command -v pavucontrol >/dev/null && exec pavucontrol'",
    "on-click-right": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume mute-toggle'",
    "on-click-middle": "sh -c 'command -v pavucontrol >/dev/null && exec pavucontrol'",
    "on-scroll-up": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume raise'",
    "on-scroll-down": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume lower'",
    "tooltip-format": "<b>Output Device</b>: {desc}"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤯",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "min-length": 2,
    "max-length": 2,
    "tooltip-format-wifi": "<b>Network</b>: {essid}\n<b>IP Addr</b>: {ipaddr}/{cidr}\n<b>Strength</b>: {signalStrength}%",
    "tooltip-format-ethernet": "<b>Interface</b>: {ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Wi-Fi Disconnected",
    "on-click": "sh -c 'command -v nm-connection-editor >/dev/null && exec nm-connection-editor'"
  },
  /*-- Media --*/
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} {title} - {artist}",
    "player-icons": { "default": "󰐊" },
    "status-icons": { "paused": "󰏤" },
    "max-length": 30,
    "tooltip-format": "Playing: {title} - {artist}",
    "tooltip-format-paused": "Paused: {title} - {artist}"
  },

  /*-- Tray --*/
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  /*-- Idle --*/
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "min-length": 3,
    "max-length": 3,
    "tooltip-format-activated": "<b>Idle Inhibitor</b>: Activated",
    "tooltip-format-deactivated": "<b>Idle Inhibitor</b>: Deactivated"
  }
}
