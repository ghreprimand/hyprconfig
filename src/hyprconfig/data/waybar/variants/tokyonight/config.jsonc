{
  "layer": "top",
  "position": "top",
  "height": 0,
  "spacing": 0,
  "reload_style_on_change": true,

  /*-- Tokyo Night theme layout
       Based on ttpears/waybar Tokyo Night theme
       (https://github.com/ttpears/waybar)
       Grouped pill modules with soft blue-purple pastels --*/

  "modules-left": [
    "group/nav",
    "group/apps",
    "mpris"
  ],
  "modules-center": [],
  "modules-right": [
    "group/clock",
    "group/stats",
    "group/audio",
    "group/net",
    "group/power"
  ],

  /*-- Groups (pill containers) --*/
  "group/nav": {
    "orientation": "horizontal",
    "modules": ["custom/logo", "hyprland/workspaces"]
  },
  "group/apps": {
    "orientation": "horizontal",
    "modules": ["wlr/taskbar", "hyprland/window"]
  },
  "group/clock": {
    "orientation": "horizontal",
    "modules": ["clock#time", "clock#date"]
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio"]
  },
  "group/net": {
    "orientation": "horizontal",
    "modules": ["network", "tray"]
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": ["idle_inhibitor", "custom/power"]
  },

  /*-- Custom modules --*/
  "custom/logo": {
    "format": "󱄅",
    "tooltip": false,
    "on-click": "sh -c 'command -v rofi >/dev/null && (pkill -x rofi || exec rofi -show drun -show-icons)'"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "sh -c 'command -v wlogout >/dev/null && exec wlogout'"
  },

  /*-- Workspaces --*/
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "all-outputs": false,
    // --- monitor-workspace map (regenerated by update-waybar-monitors.sh) ---
    "persistent-workspaces": {
      "*": [1, 2, 3]
    },
    // --- end monitor-workspace map ---
    "on-click": "activate",
    "sort-by-number": true
  },

  /*-- Taskbar --*/
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "spacing": 3,
    "on-click": "activate",
    "on-click-right": "close",
    "tooltip-format": "{title}"
  },

  /*-- Window title --*/
  "hyprland/window": {
    "max-length": 35,
    "separate-outputs": true
  },

  /*-- Clock --*/
  "clock#time": {
    "format": "  {:%I:%M %p}",
    "tooltip": false
  },
  "clock#date": {
    "format": "  {:%a %b %d}",
    "tooltip": false,
  },

  /*-- System --*/
  "cpu": {
    "format": "  {usage}%",
    "interval": 3,
    "on-click": "sh -c 'command -v foot >/dev/null && command -v btop >/dev/null && exec foot -e btop'",
    "states": { "warning": 70, "critical": 90 }
  },
  "memory": {
    "format": "  {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "on-click": "sh -c 'command -v foot >/dev/null && command -v btop >/dev/null && exec foot -e btop'",
    "states": { "warning": 70, "critical": 90 }
  },
  "temperature": {
    "format": "{icon} {temperatureC}°",
    "format-icons": ["", "", "", "", ""],
    "critical-threshold": 80,
    "tooltip-format": "{temperatureC}°C / {temperatureF}°F"
  },

  /*-- Audio / Network --*/
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "format-icons": {
      "headphone": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "sh -c 'command -v pavucontrol >/dev/null && exec pavucontrol'",
    "on-click-right": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume mute-toggle'",
    "on-click-middle": "sh -c 'command -v pavucontrol >/dev/null && exec pavucontrol'",
    "on-scroll-up": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume raise'",
    "on-scroll-down": "sh -c 'command -v swayosd-client >/dev/null && exec swayosd-client --output-volume lower'",
    "tooltip-format": "{desc}: {volume}%"
  },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰅙",
    "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n󰕒 {bandwidthUpBits}  󰕄 {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\n󰕒 {bandwidthUpBits}  󰕄 {bandwidthDownBits}",
    "on-click": "sh -c 'command -v nm-connection-editor >/dev/null && exec nm-connection-editor'"
  },
  /*-- Media --*/
  "mpris": {
    "format": "{player_icon} {title} — {artist}",
    "format-paused": "{status_icon} {title} — {artist}",
    "player-icons": { "default": "▶" },
    "status-icons": { "paused": "⏸" },
    "max-length": 30,
    "tooltip": false
  },

  /*-- Tray --*/
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  /*-- Idle --*/
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Caffeine ON",
    "tooltip-format-deactivated": "Caffeine OFF"
  }
}
